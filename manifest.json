{
  "manifest_version": 3,
  "name": "First Backlog",
  "version": "1.0.0",
  "description": "Puts your Backlog list before Open on GitLab issue boards, and gives Open, Closed and every list a clear color.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "First Backlog",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gitlab.com/*"
      ],
      "exclude_matches": [
        "https://gitlab.com/*/-/boards*"
      ],
      "js": [
        "settings.js",
        "corners.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gitlab.com/*/-/boards*"
      ],
      "js": [
        "settings.js",
        "corners.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ]
}
